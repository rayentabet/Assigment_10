# Copy this file to services/agent-system-b/.env and fill in the values locally.
# google-adk's Gemini integration reads GOOGLE_API_KEY, not GEMINI_API_KEY
# (the variable name the root app's .env uses for langchain-google-genai).
GOOGLE_API_KEY=

# DigiKey OAuth credentials for product search and purchasing.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_ACCOUNT_ID=
DIGIKEY_SANDBOX=true
DIGIKEY_SITE=US
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=USD
DIGIKEY_TIMEOUT_SECONDS=20

# Separate sandbox Ordering app (three-legged OAuth).
DIGIKEY_ORDER_CLIENT_ID=
DIGIKEY_ORDER_CLIENT_SECRET=
DIGIKEY_ORDER_REDIRECT_URI=http://localhost:8010/auth/digikey/callback
DIGIKEY_ORDER_SANDBOX=true

# Backend-only protection for OAuth state and persisted access/refresh tokens.
DIGIKEY_TOKEN_ENCRYPTION_KEY=

COMPONENT_MANAGER_MODEL=gemini-3.1-flash-lite
# Hostname advertised in the Agent Card's RPC URL, not the uvicorn bind
# address. Use "component-manager" instead when calling this service from
# another container on the same Docker Compose network.
ADVERTISED_HOST=127.0.0.1
PORT=8002
DATABASE_PATH=component_manager/data/component_manager.sqlite
PROPOSAL_TTL_MINUTES=15
SPENDING_LIMIT=200.0
# Generate a long random value, for example: openssl rand -hex 32
APPROVAL_TOKEN_SECRET=
