MAX_AGENT_ITERATIONS=6
GENERATED_DIRECTORY=generated
OPENSCAD_EXECUTABLE=openscad

# Existing RAG configuration
RAG_PROJECT_PATH=/Users/rayentabet/Desktop/InMind/Assignment_8
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=arduino_rag
