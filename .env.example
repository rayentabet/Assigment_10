# Copy this file to .env and fill in the API keys locally.
GROQ_API_KEY=
GEMINI_API_KEY=

SUPERVISOR_MODEL=openai/gpt-oss-120b
GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
RAG_MODEL=gemini-3.1-flash-lite
CODE_MODEL=qwen/qwen3.6-27b
WIRING_MODEL=qwen/qwen3.6-27b
VISUALIZATION_MODEL=gemini-3.1-flash-lite
# Small model that generates each thread's short chat title after its first reply.
TITLE_MODEL=openai/gpt-oss-20b

# OpenRouter fallback, tried only when a role's primary model call fails.
# Get a key at https://openrouter.ai. Left blank, no fallback is attached at
# all and a primary rate limit or outage fails the request, so set it if you
# want agents to survive one provider going down mid-run. One fallback model
# is shared across every role.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b

MAX_AGENT_ITERATIONS=6
GENERATED_DIRECTORY=generated

# Lithic Sandbox payment provider (server-side only)
APP_ENVIRONMENT=development
PAYMENT_PROVIDER=lithic
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
LITHIC_TIMEOUT_SECONDS=20

# Existing RAG configuration
RAG_PROJECT_PATH=services/mcp-server/rag
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=arduino_rag
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Generate a long random value, for example: openssl rand -hex 32
MCP_AUTH_TOKEN=
CHAT_DATABASE_PATH=data/chat_history.sqlite
API_BASE_URL=http://127.0.0.1:8000

# Component Manager (System B) A2A endpoint. DigiKey and System B settings live
# in services/agent-system-b/.env; see its .env.example.
COMPONENT_MANAGER_A2A_URL=http://127.0.0.1:8002
A2A_TIMEOUT_SECONDS=60
A2A_MAX_RETRIES=2

# React frontend dev server origin(s), as a JSON array
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
