# Copy this file to .env and fill in the API keys locally.
GROQ_API_KEY=
GEMINI_API_KEY=

# DigiKey API credentials used by the procurement agent (System B).
# Create an application in DigiKey's developer portal and paste its OAuth
# client ID and client secret here. These values must stay on the backend.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_ACCOUNT_ID=
DIGIKEY_SANDBOX=true
DIGIKEY_SITE=US
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=USD
DIGIKEY_TIMEOUT_SECONDS=20

# Separate sandbox Ordering app (three-legged OAuth). The redirect URI must
# exactly match the callback registered in DigiKey's developer portal.
DIGIKEY_ORDER_CLIENT_ID=
DIGIKEY_ORDER_CLIENT_SECRET=
DIGIKEY_ORDER_REDIRECT_URI=https://localhost:8000/auth/digikey/callback
DIGIKEY_ORDER_SANDBOX=true

# Secrets used by the backend to validate OAuth state and encrypt stored tokens.
DIGIKEY_TOKEN_ENCRYPTION_KEY=

SUPERVISOR_MODEL=openai/gpt-oss-120b
GUARDRAIL_MODEL=openai/gpt-oss-safeguard-20b
RAG_MODEL=gemini-3.1-flash-lite
CODE_MODEL=qwen/qwen3.6-27b
WIRING_MODEL=qwen/qwen3.6-27b
VISUALIZATION_MODEL=gemini-3.1-flash-lite

MAX_AGENT_ITERATIONS=6
GENERATED_DIRECTORY=generated
OPENSCAD_EXECUTABLE=openscad

# Existing RAG configuration
RAG_PROJECT_PATH=/Users/rayentabet/Desktop/InMind/Assignment_8
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=arduino_rag
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Generate a long random value, for example: openssl rand -hex 32
MCP_AUTH_TOKEN=
CHAT_DATABASE_PATH=data/chat_history.sqlite
API_BASE_URL=http://127.0.0.1:8000

# Component Manager (System B) A2A endpoint. See component_manager/.env.example
# for that service's own configuration.
COMPONENT_MANAGER_A2A_URL=http://127.0.0.1:8002
A2A_TIMEOUT_SECONDS=60
A2A_MAX_RETRIES=2

# React frontend (web/) dev server origin(s), as a JSON array
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
